{
  "name": "flyrewheel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted evidence-backed quality rule learning and replay with OpenAI Codex",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "node --import tsx src/cli.ts demo",
    "cli": "node --import tsx src/cli.ts",
    "worker": "node --import tsx src/worker.ts",
    "experiment:vllm": "node --import tsx experiments/vllm/replay.ts",
    "validate:deploy": "node deploy/validate.mjs"
  },
  "dependencies": {
    "@ast-grep/lang-python": "0.0.6",
    "@ast-grep/napi": "0.45.3",
    "@aws-sdk/client-s3": "3.1143.0",
    "@electric-sql/pglite": "0.5.8",
    "@openai/codex-sdk": "0.159.2",
    "commander": "15.0.0",
    "openai": "7.25.0",
    "pg": "8.23.1",
    "pg-boss": "12.35.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
