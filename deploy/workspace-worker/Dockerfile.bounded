# Single-stage, two filesystem-changing steps for constrained VFS builders.
# npmcache must contain only this build's public lockfile-verified _cacache.
ARG WORKSPACE_WORKER_BASE_IMAGE
FROM ${WORKSPACE_WORKER_BASE_IMAGE}
ARG WORKSPACE_WORKER_BASE_IMAGE
USER 0:0
SHELL ["/bin/sh", "-c"]
WORKDIR /opt/flyrewheel
COPY . ./
# Bind cache writes are temporary and are not committed to the image.
# Never copy host node_modules, auth, proxy configuration or CA files.
RUN --mount=type=bind,from=npmcache,target=/npm-cache,rw \
    /usr/local/bin/node deploy/workspace-worker/prepare-image.mjs check-base \
    && npm ci --offline --cache /npm-cache --include=dev --include=optional --ignore-scripts --no-audit --no-fund \
    && ./node_modules/.bin/tsc -p deploy/tsconfig.build.json \
    && test -f dist/workspace-worker-entrypoint.js \
    && mkdir -p dist/storage/migrations \
    && cp src/storage/migrations/*.sql dist/storage/migrations/ \
    && /usr/local/bin/node deploy/workspace-worker/prepare-image.mjs stage-codex \
    && npm prune --offline --cache /npm-cache --omit=dev --ignore-scripts --no-audit --no-fund \
    && rm -rf node_modules/@openai/codex-linux-*/vendor \
    && mkdir bin \
    && cp deploy/workspace-worker/workspace-worker bin/workspace-worker \
    && cp deploy/workspace-worker/workspace-worker.json workspace-worker.json \
    && rm -rf src deploy tsconfig.json \
    && test -x /usr/local/bin/node && test -x /usr/bin/git \
    && test -x codex/bin/codex \
    && chmod 0555 bin/workspace-worker \
    && chmod -R a-w /opt/flyrewheel \
    && mkdir -p /workspace/repo /run/flyrewheel \
    && chown 0:0 /opt /opt/flyrewheel /workspace \
    && chmod 0555 /opt /opt/flyrewheel /workspace \
    && chown 10001:10001 /workspace/repo \
    && chmod 0700 /workspace/repo \
    && chown 0:10001 /run/flyrewheel \
    && chmod 0750 /run/flyrewheel
ENV NODE_ENV=production HOME=/nonexistent PATH=/usr/local/bin:/usr/bin:/bin TMPDIR=/tmp LANG=C LC_ALL=C
USER 10001:10001
WORKDIR /workspace/repo
HEALTHCHECK NONE
STOPSIGNAL SIGTERM
ENTRYPOINT []
CMD ["/bin/sleep", "infinity"]
